# Copy to .env for local runs. On Render, set these in the Environment tab instead.
ROBOFLOW_API_KEY=paste_your_NEW_key_here
ROBOFLOW_MODEL_ID=drowsiness-detection-system-3uv1a/5
DEMO_TOKEN=pick-a-long-random-string
MIN_CONFIDENCE=0.5
DROWSY_CLASSES=drowsy,fatigue
AWAKE_CLASSES=awake
# Set to 1 to print the raw Roboflow response in the server log
DEBUG_RAW=0
PORT=3000
